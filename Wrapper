	const base = (max or 125)-rem; -- TODO MAX - 255 TODO MIN - 12

	module.dec = function(str)
		local number = 0
		local power = 1
		for character in str:gmatch('.') do
			if character == string.char(rem-1) then
				power = -power
			else
				number += (character:byte()-rem) * power
				power *= base
			end
		end
		return number--/1000
	end;

	module.new = new;

	return module;
end;

