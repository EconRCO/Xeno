function meta:Destroy() -- line: 37
	if self.IsDestroyed then
		return;
	end;

	self.IsDestroyed = true;

	for _, v2 in pairs(self._connections) do
		v2:Disconnect();
	end;

	for _, v3 in pairs(self._cleanup) do
		v3:Destroy();
	end;

	for _, v4 in pairs(self._tweens) do
		v4:Cancel();
		v4:Destroy();
	end;

	for _, v5 in pairs(self._threads) do
		pcall(task.cancel, v5);
	end;

	self._connections = {};
	self._cleanup = {};
	self._tweens = {};
	self._threads = {};
	
