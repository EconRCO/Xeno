local ITEM_WRAPS = {}

local save = {'Material','MaterialVariant','Color','Transparency','Reflectance'};

if not getgenv().EconWrap then
	getgenv().EconWrap = {
		saved = {};
	};
end;

local econwrap = getgenv().EconWrap;
const invertedT = {
	2,
	1,
	3
}

function mod:wrapThis(item, wrapx, inverted, ogw, ogt)
	local CURR = ITEM_WRAPS[item]
	if CURR and CURR[2] == wrapx and CURR[3] == inverted then return end

	const wrap = wraps[wrapx]
	if not wrap and wrapx ~= 'None' then return end

	--

	local CURR_IND = CURR and CURR[1]+1 or 1
	ITEM_WRAPS[item] = {CURR_IND,wrapx,inverted}

	const applied = {};

	--

	if econwrap.saved[item] then
		for p,v in econwrap.saved[item] do
			for n, s in pairs(v.OriginalProperties) do
				p[n] = s;
			end;

			for _, v in pairs(v.Cleanup) do
				v:Destroy()
			end
			if v.obj then
				v.obj:Destroy();
			end;
		end;
	end

	--

	for _, v in pairs(item:GetDescendants()) do
		local wg = v:GetAttribute'WrapGroup'
		if wg then
			wg = tonumber(wg);

			if v:IsA'BasePart' then
				if wrapx ~= 'None' then
					if inverted then
						wg = invertedT[wg]
					end

					local info = wg == 1 and wrap.g1 or wg == 2 and wrap.g2 or wrap.g3
					if info then
						local tb = {};
						for _, p in save do
							tb[p] = v[p]
						end;
						
						const x = {
							Destroy = {};

							WrapGroup = wg,
							IgnoreTransparency = v:GetAttribute('IgnoreTransparency'),
							IgnoreMaterial = v:GetAttribute('IgnoreMaterial'),
							IgnoreObject = v:GetAttribute('IgnoreObject'),
							OriginalProperties = tb;
							OriginalChildren = {};
							Cleanup = {};
						};
						applied[v]=x;

						--

						if typeof(info[1]) ~= 'string' then
							v.MaterialVariant = ''
							v.Material = info[1] or v.Material
						elseif info[1] then
							v.MaterialVariant = info[1] or ''
							v.Material = game:GetService'MaterialService':FindFirstChild(info[1], true).BaseMaterial
						end

						v.Color = info[2] or v.Color
						v.Transparency = info[3] or v.Transparency
						v.Reflectance = info[4] or v.Reflectance

						--

						const extraObjects = {};
						if info[5] then
							for _, z in pairs(ogt[info[5]]:GetChildren()) do
								const c = z:Clone();
								c.Parent = v;
								
								table.insert(applied[v].Cleanup,c);
								table.insert(extraObjects,c);
							end;
						end;
						
						if info[6] then
							const g = objects[info[6]];
							if g then
								const new = g.new(info[6],v,extraObjects);
								const i = htt:GenerateGUID(false);
								x.obj = new;
								
								if new.Update then
									run:BindToRenderStep(i,Enum.RenderPriority.Camera.Value+1,function(dt)
										if not new.Update or new.IsDestroyed then 
											run:UnbindFromRenderStep(i);
										elseif new:_IsAncestryVisible() then
											new.Update(new,dt);
										end;
									end);
								end;
							else
								warn('[ I dont believe the hype ] -> '..info[6])
							end;
						end;
					end;
				end;
			elseif v:IsA'Beam' or v:IsA'Trail' or v:IsA'ParticleEmitter' then
				if wrapx ~= 'None' then
					if inverted then
						wg = invertedT[wg]
					end

					local info = wg == 1 and wrap.g1 or wg == 2 and wrap.g2 or wrap.g3
					if info then
						applied[v] = {
							OriginalProperties = {
								Color = v.Color
							};
						};

						v.Color = info[2] and ColorSequence.new(info[2]) or v.Color;
					end
				end;
			end;
		end;
	end;

	--[[ WRAP GROUP OBJECT SHIT ]]

	econwrap.saved[item]=applied;
end;

function add_wrap(...)
	mod:add_wrap(...);
end;


