local env = getgenv();

--

local attribute = {};
do
	local all = env.all or {};
	local dis = env.dis or {};
	env.dis = dis;
	env.all = all;

	function attribute:set(x,v,a)
		local all = env.all;
		if not dis[x] then
			dis[x] = x.Destroying:Once(function()
				all[x] = nil;
				dis[x] = nil;
			end);
		end;

		all[x] = all[x] or {};
		all[x][v] = a;
	end;
	function attribute:get(x,v)
		local all = env.all;
		return all[x] and all[x][v];
	end;
end

--

return {
	init = function(UTILS)
		local __RET = {}

		-- // Services

		local players = game:GetService('Players')
		local run = game:GetService('RunService')

		-- // Vars

		local plr = players.LocalPlayer
		local scripts = plr.PlayerScripts

		local mainUI = plr.PlayerGui.MainGui.MainFrame
		local fighterInterfaces = mainUI.FighterInterfaces

		local ECON_VARS = env.ECON_VARS

		local is = ECON_VARS.TIMES_EXECUTED > 1

		-- // Main

		__RET.__handleFighterInterface = function(ui)
			if ui.Name == plr.Name then
				pcall(function()
					local funcs = {}

					local items = ui.BottomRight.Container.Hotbar.Container

					funcs.handleSlot = function(v)
						local s = env.toskin[v.Name];
						if env.enabled_skin and s and s ~= 'Dont Change' then							
							local icon = v:FindFirstChild'Icon'
							if icon then
								icon.Image = UTILS.SKIN_MOD.viewmodels[s].image;
							end;
						end;
					end;

					-- //

					items.ChildAdded:Connect(funcs.handleSlot)
					for _, v in pairs(items:GetChildren()) do
						funcs.handleSlot(v)
					end
				end);
			end
		end
		
		__RET.createSparklesFrame = function(f)
			local __ret = {}

			local sparkleCooldown = .75
			local lastSparkle = tick()
			local sparkles = {}

			function __ret:Update()
				if tick()-lastSparkle > sparkleCooldown then
					lastSparkle = tick()

					local size = 0.375 + 0.25 * math.random() * 3
					local clone = scripts.UserInterface.PrimeSparkle:Clone()
					clone.Size = UDim2.new(size, 0, size, 0)

					clone.Position = UDim2.new(0.5, (math.random() - 0.5) * f.AbsoluteSize.X, 0.5, (math.random() - 0.5) * f.AbsoluteSize.Y)
					clone.Rotation = math.random() * 360
					clone.Parent = f
					clone:TweenSize(UDim2.new(), "In", "Back", 2, true)

					table.insert(sparkles,{
						object = clone;
						spawnTick = tick();
					})
				end

				for i, v in pairs(sparkles) do
					if tick()-v.spawnTick > 2 then
						v.object:Destroy()
						table.remove(sparkles,i)
					else
						v.object.Rotation += .01*180
					end
				end
			end

			function __ret:Destroy()
				for _, v in pairs(sparkles) do
					v.object:Destroy()
				end

				__ret = nil
			end

			return __ret
		end

		if not is then
			local function checkfor(v)
				task.spawn(function()
					local typ = v.Name == 'PickWeapons' and 1 or v.Name == 'PickWeaponsList' and 2 or 0
					if typ>0 and not attribute:get(v,'e') then
						local chosen = v:WaitForChild('ChosenWeapons')
						local list = typ == 1 and v:WaitForChild('List') or v:WaitForChild('ListContainer').List
						
						attribute:set(v,'e',true);

						local cons = {}

						if chosen and list then
							list = list.Container

							-- // LIST

							local function handle(v)
								task.spawn(function()
									local b = v.Name:find('WeaponSlot') and v:WaitForChild('Button')
									if b and b:FindFirstChild('Icon') and b.Icon:FindFirstChild('Picture') then
										b = b.Icon.Picture
										b.Name = 'OPic'

										local function calc()
											local ts = UTILS.SKIN_MOD.its[b.Image]
											local base = UTILS.SKIN_INFO.skinToOg[ts] or ts
											local s = env.selskin and env.selskin[base] or env.toskin[base]
											
											if env.enabled_skin and s and s ~= 'Dont Change' then
												if s=='Random' then
													s = base;
												end;
												b.Image = UTILS.SKIN_MOD.viewmodels[s].image
											end
										end

										calc()
										table.insert(cons, b:GetPropertyChangedSignal('Image'):Connect(calc))
									end
								end)
							end

							for _, v in pairs(list:GetChildren()) do
								handle(v)
							end

							local con = list.ChildAdded:Connect(handle)
							table.insert(cons, con)

							-- // MAIN SELECTION

							local function handle2(v)
								task.spawn(function()
									if v.Name:find('ChosenSlot') then
										local b = v.Button.Picture
										local function calc()
											local ts = UTILS.SKIN_MOD.its[b.Image]
											local base = UTILS.SKIN_INFO.skinToOg[ts] or ts
											local s = env.selskin and env.selskin[base] or env.toskin[base]

											if env.enabled_skin and s and s ~= 'Dont Change' then
												if s=='Random' then
													s = base;
												end;
												b.Image = UTILS.SKIN_MOD.viewmodels[s].image
											end
										end

										calc()
										table.insert(cons, b:GetPropertyChangedSignal('Image'):Connect(calc))
									end
								end)
							end

							for _, v in pairs(chosen:GetChildren()) do
								handle2(v)
							end

							table.insert(cons, chosen.ChildAdded:Connect(handle2))
						end
					end
				end)
			end

			local pages = mainUI.Pages
			if pages:FindFirstChild('PickWeapons') then
				checkfor(pages.PickWeapons)
			end

			pages.ChildAdded:Connect(checkfor)
		end

		for _, v in pairs(fighterInterfaces:GetChildren()) do
			__RET.__handleFighterInterface(v)
		end

		-- //

		return __RET
	end,
}
